# Compose / ports
WEB_PORT=80
OPENCODE_HOST_PORT=4096

# FastAPI -> opencode
# Keep this as http://opencode:4096 when using the compose-bundled opencode service.
# Replace it with your external opencode gateway address when FastAPI should call an external service.
OPENCODE_BASE_URL=http://opencode:4096
# These two values decide which provider/model FastAPI asks opencode to use.
OPENCODE_PROVIDER_ID=opencode
OPENCODE_MODEL_ID=big-pickle
OPENCODE_TIMEOUT_SEC=60

# opencode service
OPENCODE_SERVER_PASSWORD=
# If you prefer auth.json instead of API keys, put auth.json under this host directory.
OPENCODE_AUTH_HOST_DIR=./opencode-auth
# Fill only the key you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# FastAPI -> OnlyOffice
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_BACKEND_BASE_URL=http://fastapi:8000

# OnlyOffice service
ONLYOFFICE_ALLOW_PRIVATE_IP_ADDRESS=true
