FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_APP_ENV=production
ARG VITE_API_BASE_URL=/api
ARG VITE_ONLYOFFICE_DOCUMENT_SERVER_URL=/ds
ARG VITE_ONLYOFFICE_HEALTHCHECK_PATH=/healthcheck

ENV VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_ONLYOFFICE_DOCUMENT_SERVER_URL=${VITE_ONLYOFFICE_DOCUMENT_SERVER_URL} \
    VITE_ONLYOFFICE_HEALTHCHECK_PATH=${VITE_ONLYOFFICE_HEALTHCHECK_PATH}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
