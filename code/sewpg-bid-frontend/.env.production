VITE_APP_ENV=production

# Use enterprise gateway / API domain in production
VITE_API_BASE_URL=https://your-api-domain.example.com/api
VITE_API_TIMEOUT_MS=15000
VITE_API_RETRY_COUNT=1
VITE_API_ENABLE_TRACE=true

# Use production OnlyOffice endpoint
VITE_ONLYOFFICE_DOCUMENT_SERVER_URL=https://your-onlyoffice-domain.example.com
VITE_ONLYOFFICE_HEALTHCHECK_PATH=/healthcheck

