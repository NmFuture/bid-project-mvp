FROM python:3.12-slim

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG HF_ENDPOINT=https://hf-mirror.com

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=10 \
    HF_ENDPOINT=${HF_ENDPOINT} \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    BID_DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    DOCLING_DEVICE=cuda

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docling-lock.txt requirements-docling-worker.txt requirements-torch-cuda.txt ./
# 预置 wheel 目录：通常为空，pip 照常从网络安装；网络不稳时可把体积大、
# 反复下载失败的包（如 nvidia-cublas，423 MB）用 `wget -c` 断点续传取回后
# 放入 wheels/。pip 本身不支持断点续传，中断即整包作废。
# 注意必须先 `--no-deps` 安装本地 wheel，再执行后续安装：torch 在
# download.pytorch.org 索引中把这些 CUDA 依赖声明为带 sha256 的直接 URL，
# 此时 pip 只认该 URL、不参与 --find-links 的候选比较；先装上之后 pip 会
# 判定 "Requirement already satisfied" 而跳过下载。
COPY wheels/ /wheels/
RUN --mount=type=cache,target=/root/.cache/pip \
    if ls /wheels/*.whl >/dev/null 2>&1; then pip install --no-deps /wheels/*.whl; fi \
    && pip install --index-url "${PIP_INDEX_URL}" -c requirements-docling-lock.txt pillow --find-links /wheels \
    && pip install --index-url "${PYTORCH_CUDA_INDEX_URL}" -r requirements-torch-cuda.txt --find-links /wheels \
    && pip install --extra-index-url "${PYTORCH_CUDA_INDEX_URL}" -r requirements-docling-worker.txt --find-links /wheels \
    && pip check \
    && python -c "import torch; assert torch.version.cuda == '13.0', f'expected CUDA 13.0 torch, got {torch.version.cuda}'"

COPY scripts/download_docling_models.py ./scripts/download_docling_models.py
RUN --mount=type=cache,target=/root/.cache/huggingface \
    python scripts/download_docling_models.py /opt/docling-models --quiet

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY app ./app

CMD ["python", "-m", "app.workers.docling_worker"]
