# Air-gapped deployment template

# Web / image tags
WEB_PORT=80
OPENCODE_HOST_PORT=4096
APP_IMAGE_TAG=offline-latest
WEB_IMAGE=sewpg-bid/web:offline-latest
FASTAPI_IMAGE=sewpg-bid/fastapi:offline-latest
DOCLING_IMAGE=sewpg-bid/docling-worker:offline-latest
OPENCODE_IMAGE=sewpg-bid/opencode:offline-latest
ONLYOFFICE_IMAGE=sewpg-bid/onlyoffice:9.3.1.2
REDIS_IMAGE=redis:7-alpine
OCR_IMAGE=vllm/vllm-openai:unlimited-ocr
OCR_HOST_PORT=8000
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu130

# FastAPI -> PostgreSQL project/material store
APP_STORE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://biduser:bidpass@postgres:5432/bidplatform
POSTGRES_USER=biduser
POSTGRES_PASSWORD=bidpass
POSTGRES_DB=bidplatform
POSTGRES_PORT=5432

# FastAPI / worker -> MinIO object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_MATERIALS=bid-materials
MINIO_BUCKET_DOCUMENTS=bid-documents
MINIO_BUCKET_TEMPLATES=bid-templates
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# FastAPI -> opencode
OPENCODE_BASE_URL=http://opencode:4096
OPENCODE_PROVIDER_ID=internal-openai
OPENCODE_MODEL_ID=replace-with-your-internal-model
OPENCODE_TIMEOUT_SEC=1800
OPENCODE_MAX_CONCURRENCY=1
DEFAULT_LLM_PROVIDER_ID=internal-openai

# 独立 Docling worker 使用镜像内模型和本机 Docker 共享卷，不经过网络传输 PDF。
BUSINESS_PDF_PARSE_ENGINE=docling
BUSINESS_PDF_ENGINE_FALLBACK=none
DOCLING_DEVICE=cpu
DOCLING_HEALTHCHECK_START_PERIOD=10m
DOCLING_STOP_GRACE_PERIOD=30m
DOCLING_CPU_LIMIT=8.0
DOCLING_CPU_THREADS=8
DOCLING_MEMORY_LIMIT=32g

# Internal OpenAI-compatible LLM gateway
INTERNAL_LLM_BASE_URL=http://your-internal-llm-gateway/v1
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_PROVIDER_NAME=Internal LLM Gateway
INTERNAL_LLM_MODEL_LABEL=Internal LLM Model
INTERNAL_LLM_HEADERS_JSON=
DEFAULT_LLM_BASE_URL=http://your-internal-llm-gateway/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=replace-with-your-internal-model

# Optional local OCR service powered by baidu/Unlimited-OCR on vLLM.
# Include docker-compose.ocr.yml and docker-compose.ocr.airgap.yml when starting.
DEFAULT_OCR_BASE_URL=http://ocr:8000/v1
DEFAULT_OCR_API_KEY=
DEFAULT_OCR_MODEL=baidu/Unlimited-OCR
OCR_MODEL=baidu/Unlimited-OCR
OCR_GPU_DEVICE_ID=0
OCR_HF_CACHE_DIR=./.localdata/ocr/huggingface
OCR_SHM_SIZE=8g
OCR_HEALTHCHECK_START_PERIOD=20m
HUGGING_FACE_HUB_TOKEN=
HF_ENDPOINT=
VLLM_USE_MODELSCOPE=false

# Keep blank unless you still need external providers on the packaging machine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENCODE_SERVER_PASSWORD=
OPENCODE_AUTH_HOST_DIR=./opencode-auth
OPENCODE_NPM_VERSION=1.18.2

# FastAPI / worker -> Redis background queue
REDIS_URL=redis://redis:6379/0
REDIS_JOB_LOCK_TTL_SEC=7200
REDIS_JOB_QUEUE_LOCK_TTL_SEC=21600
REDIS_JOB_RESULT_TTL_SEC=86400
REDIS_WORKER_POLL_TIMEOUT_SEC=5
REDIS_DOCLING_QUEUE_KEY=bid:jobs:docling

# Upload hardening
MAX_UPLOAD_FILE_SIZE_BYTES=524288000
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.md,.txt,.xls,.xlsx,.xlsm,.png,.jpg,.jpeg,.webp,.bmp,.tif,.tiff

# FastAPI -> OnlyOffice
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_BACKEND_BASE_URL=http://fastapi:8000

# OnlyOffice callback/download hardening
ONLYOFFICE_CALLBACK_TOKEN=
ONLYOFFICE_CALLBACK_ALLOWED_HOSTS=onlyoffice,127.0.0.1,localhost
ONLYOFFICE_DOWNLOAD_ALLOWED_HOSTS=onlyoffice,127.0.0.1,localhost
ONLYOFFICE_DOWNLOAD_MAX_BYTES=524288000

# OnlyOffice service
ONLYOFFICE_ALLOW_PRIVATE_IP_ADDRESS=true
ONLYOFFICE_MAX_DOWNLOAD_BYTES=524288000
ONLYOFFICE_TEMPFILE_UPLOAD_LIMIT_BYTES=524288000
ONLYOFFICE_IMAGE_SIZE_LIMIT_BYTES=52428800
ONLYOFFICE_DOWNLOAD_TIMEOUT=10m
ONLYOFFICE_NGINX_CLIENT_MAX_BODY_SIZE=512m
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=false
